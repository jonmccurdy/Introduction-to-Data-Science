# Distribution: How a quantitative variable is spread out across its possible values
library(openintro)
library(MSMU)
# Distribution: How a quantitative variable is spread out across its possible values
library(openintro)
library(MSMU)
# Center: mean, median, mode
# We want to describe the "typical" observation in the distribution
head(babies$bwt)
mean(babies$bwt)
median(babies$bwt)
mean(babies$bwt, trim=0.1)
# If the mean > median > mode then we might have outliers on the right
# This might indicate the data is right-skewed
# If the mean < median < mode then we might have outliers on the left
# This might indicate the data is left-skewed
# If the mean = median = mode this might indicate the data is symmetric
center_stats(babies$bwt)
hist(babies$bwt, freq=FALSE)
lines(density(babies$bwt), col="red")
center_stats(cars93$price)
hist(cars92$bwt, freq=FALSE)
hist(cars93$bwt, freq=FALSE)
hist(cars93$price, freq=FALSE)
lines(density(cars93$price), col="red")
center_stats(exam_grades$exam2)
hist(exam_grades$exam2, freq=FALSE)
lines(density(exam_grades$exam2), col="red")
# Position Stats: Quartiles
# Q1: 25th percentile
# Q2: 50th percentile (median)
# Q3: 75th percentile
# 0-25, 25-50, 50-75, 75-100
# Percentiles: what percent of the data is less then this value
quantile(babies$bwt, 0.25)
quantile(babies$bwt, c(0, 0.25, 0.5, 0.75, 1))
summary(babies$bwt)
# To see if the data is symmetric then we should compare the left side to the right side
# Q2 - min and max - Q2
# Q1 - min and max - Q3
# Q2 - Q1 and  Q3 - Q2
position_stats(babies$bwt)
# Left-hand side is spread out over 120 - 55 = 65 units
# Right-hand side is spread out over 176 - 120 = 56 units
# Bottom 25% of data is spread out over 108.75 - 55 = 53.75 units
# Top 25% of the data is spread out over 176- 131 = 45 units
boxplot(babies$bwt, horizontal = TRUE)
position_stats(cars93$price)
boxplot(cars93$price, horizontal = TRUE)
position_stats(exam_grades$exam2)
boxplot(exam_grades$exam2, horizontal = TRUE)
# Spread of Dataset
# Range, Standard Deviation, IQR (Inter-Quartile Range: Q3 - Q1)
spread_stats(babies$bwt)
# The z-score is how far away a value is from the mean in terms of standard deviations
# pct1 is the percent of data within 1 SD of the mean
# pct2 is the percent of data within 2 SD of the mean
# pct3 is the percent of data within 3 SD of the mean
# If we are normally distributed we would expect 68-95-99.7
spread_stats(cars93$price)
spread_stats(exam_grades$exam2)
# Shape of a distribution
# Outlier (a far away value) if it is 1.5* IQR away from the mean
# "lower fence" = Q1 - 1.5*IQR
# "upper fence" = Q3 + 1.5*IQR
babies$bwt
babies$bwt < quantile(babies$bwt, 0.25)
sum(babies$bwt < (quantile(babies$bwt, 0.25) - 1.5*IQR(babies$bwt)))
sum(babies$bwt > (quantile(babies$bwt, 0.75) + 1.5*IQR(babies$bwt)))
# Skew: Quantify this as a number (mean of the z-scores cubed)
# values between -0.5 and 0.5 is symmetric
# values between -1 and -0.5 or 0.5 and 1 is moderately skewed
# values less then -1 or greater than 1 is highly skewed
# Kurtosis: Thickness of the tails compared a normal distribution
spread_stats(cars93$price)
# We expected 99.7% of data to be within 3 SD (0.3% in the "tails")
# We have 98.15% of the data within 3 SD (1.85% in the "tails")
# We have "thicker" tails and thus a positive kurtosis
spread_stats(exam_grades$exam2)
# We expected 99.7% of data to be within 3 SD (0.3% in the "tails")
# We have 100% of the data within 3 SD (0% in the "tails")
# We have "thinner" tails and thus a negative kurtosis
shape_stats(babies$bwt)
shape_stats(cars93$price)
shape_stats(exam_grades$exam2)
center_stats(exam_grades$exam2)
position_stats(exam_grades$exam2)
spread_stats(exam_grades$exam2)
shape_stats(exam_grades$exam2)
hist(exam_grades$exam2)
boxplot(exam_grades$exam2, horizontal=TRUE)
