n = n(),
mean_volume = mean(volume),
median_volume = median(volume),
sd_volume = sd(volume),
.groups = "drop"
)
ggplot(RailTrail, aes(x = dayType, y = volume, fill = dayType)) +
geom_boxplot() +
stat_summary(fun = "mean", geom = "point", shape = 23, size = 3,
fill = "white", color = "black") +
labs(
title = "Trail Volume by Day Type",
x = "Day Type",
y = "Trail Volume"
) +
theme(
legend.position = "none",
plot.title = element_text(hjust = 0.5)
)
railtrail_cat <- RailTrail |>
mutate(high_use = ifelse(volume > median(volume), "Above Median", "At or Below Median"))
railtrail_cat |>
count(dayType, high_use) |>
group_by(dayType) |>
mutate(proportion = n / sum(n))
ggplot(railtrail_cat, aes(x = dayType, fill = high_use)) +
geom_bar(position = "fill") +
labs(
title = "Proportion of High-Use Days by Day Type",
x = "Day Type",
y = "Proportion",
fill = "Trail Use"
) +
theme(plot.title = element_text(hjust = 0.5))
